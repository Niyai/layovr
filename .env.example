# Copy to .env (repo root). Every value is optional for local hosting.

# --- API (apps/api) ---
PORT=8787
# Leave unset to use the embedded Postgres (PGlite) stored in apps/api/.data/.
# Set to any Postgres URL (Supabase, Neon, local) to use that instead.
# DATABASE_URL=postgres://user:pass@host:5432/layovr
# Signs staff session cookies. Required in production: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me
# Without FLW_SECRET_KEY, checkout runs in demo mode (no money moves).
# FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx-X
# FLW_SECRET_HASH=the-secret-hash-you-set-in-the-flutterwave-dashboard
# Where buyers land after paying; must be reachable from their phone.
PUBLIC_APP_URL=http://localhost:8080
# Show demo staff PINs on /staff (defaults: on in dev, off in production).
# SHOW_DEMO_PINS=true
# ALLOW_DEMO_RESET=true

# OpenStreetMap place search (used when no Google key) needs an identifying User-Agent.
# GEO_USER_AGENT=Layovr/0.1 (https://layovr.app; ops@layovr.app)

# --- Web (apps/web) ---
# Google Places address search in the event wizard. Enable "Maps JavaScript API"
# and "Places API (New)" on the key and restrict it to your site's referrer.
# Without it, the wizard falls back to OpenStreetMap search.
# VITE_GOOGLE_MAPS_API_KEY=
# Where the web dev server forwards /api requests.
API_URL=http://localhost:8787
